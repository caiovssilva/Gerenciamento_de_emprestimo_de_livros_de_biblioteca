# ── Configuração da Aplicação ────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-secret-key-in-production

# ── Configuração do Supabase ──────────────────────────────────────────
# IMPORTANTE: Obtenha essas credenciais no console do Supabase
# https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sb_service_role_key_from_supabase
SUPABASE_KEY=sb_anon_public_key_from_supabase

# ── Modo de banco de dados ────────────────────────────────────────────
# Se deixar vazio ou com erro de conexão, usa JSON local (modo offline)
DATABASE_MODE=supabase

# ── Segurança ─────────────────────────────────────────────────────────
# Use credenciais de autenticação seguindo estas práticas:
# 1. NUNCA commite credenciais reais no git
# 2. Use variáveis de ambiente em produção
# 3. Implemente bcrypt ou argon2 para hash de senhas
ENABLE_DEFAULT_CREDENTIALS=true
