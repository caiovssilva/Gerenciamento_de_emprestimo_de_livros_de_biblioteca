# Exemplo de configuração do backend. Não use valores reais neste arquivo.
# Prefira Secrets do GitHub Codespaces/Render para credenciais.

# Inicialização Flask
FLASK_ENV=development
FLASK_PORT=5000
# PORT é fornecida normalmente pela plataforma de hospedagem.
PORT=
SECRET_KEY=
SELF_SERVICE_SECRET_KEY=
AUTH_DEBUG=

# Supabase usado pelo backend. Mantenha service role somente no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_KEY=

# Compatibilidade: a rotina agendada de manutenção do Supabase lê este secret.
# Configure SUPABASE_ANON_KEY como GitHub Actions Secret, não como chave privada.
SUPABASE_ANON_KEY=

# Consulta ISBN e reconhecimento de imagem (todas as chaves são opcionais)
GOOGLE_BOOKS_API_KEY=
GROQ_API_KEY=
API_GROQ=
GROQ_API=
GROQ_MODEL=allam-2-7b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
ISBNDB_API_KEY=
ISBN_VISION_PROVIDER=groq
